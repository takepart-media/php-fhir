{
    "name": "takepartdev/laravel-fhir",
    "description": "Laravel-FHIR package",
    "type": "library",
    "authors": [
        {
            "name": "Kulcsar Kalman",
            "email": "kalman.kulcsar@lynxsolutions.eu"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.1|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Takepartdev\\LaravelFhir\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Takepartdev\\LaravelFhir\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Takepartdev\\LaravelFhir\\FhirProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:dox": "vendor/bin/phpunit --testdox"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
